{
    "version": 2,
    "builds": [
        {
            "src": "api/upload.js",
            "use": "@vercel/node"
        },
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "admin.html",
            "use": "@vercel/static"
        },
        {
            "src": "style.css",
            "use": "@vercel/static"
        },
        {
            "src": "script.js",
            "use": "@vercel/static"
        },
        {
            "src": "admin.js",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/upload",
            "dest": "/api/upload.js"
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/style.css",
            "dest": "/style.css"
        },
        {
            "src": "/script.js",
            "dest": "/script.js"
        },
        {
            "src": "/admin.js",
            "dest": "/admin.js"
        },
        {
            "src": "/",
            "dest": "/index.html"
        }
    ]
}